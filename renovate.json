{
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":semanticCommitTypeAll(chore)",
    ":disableDependencyDashboard"
  ],
  "rangeStrategy": "bump",
  "npm": {
    "commitMessageTopic": "{{prettyDepType}} {{depName}}"
  },
  "gomod": {
    "commitMessageTopic": "{{prettyDepType}} {{depName}}"
  },
  "packageRules": [
    {
      "description": "The scaffold template's versions are generated from the pnpm catalog by `pnpm sync:template` (update-template-deps workflow); Renovate updates the catalog instead.",
      "matchFileNames": [
        "packages/create-uozi-admin/template/**"
      ],
      "enabled": false
    },
    {
      "description": "shared-config's peer ranges decide which Vite/UnoCSS versions consumer apps may use; keep them wide and raise the lower bound only on purpose (with a changeset), never as a side effect of a dependency bump.",
      "matchFileNames": [
        "packages/shared-config/package.json"
      ],
      "matchDepTypes": [
        "peerDependencies"
      ],
      "rangeStrategy": "widen"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeSchedule": [
        "after 1am and before 2am"
      ],
      "schedule": [
        "after 2am and before 3am"
      ]
    }
  ]
}
